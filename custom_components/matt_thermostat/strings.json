{
  "title": "Matt thermostat",
  "config": {
    "step": {
      "user": {
        "title": "Create matt thermostat",
        "description": "Create a climate entity that controls the temperature via a switch and sensor.",
        "data": {
          "ac_mode": "Cooling mode",
          "heater": "Actuator switch",
          "target_sensor": "Temperature sensor",
          "name": "[%key:common::config_flow::data::name%]",
          "cold_tolerance": "Cold tolerance",
          "hot_tolerance": "Hot tolerance",
          "min_temp": "Minimum target temperature",
          "max_temp": "Maximum target temperature"
        },
        "data_description": {
          "ac_mode": "Set the actuator specified to be treated as a cooling device instead of a heating device.",
          "heater": "Switch entity used to cool or heat depending on A/C mode.",
          "target_sensor": "Temperature sensor that reflects the current temperature.",
          "cold_tolerance": "Minimum amount of difference between the temperature read by the temperature sensor the target temperature that must change prior to being switched on. For example, if the target temperature is 25 and the tolerance is 0.5 the heater will start when the sensor goes below 24.5.",
          "hot_tolerance": "Minimum amount of difference between the temperature read by the temperature sensor the target temperature that must change prior to being switched off. For example, if the target temperature is 25 and the tolerance is 0.5 the heater will stop when the sensor equals or goes above 25.5."
        }
      },
      "presets": {
        "title": "Temperature presets",
        "data": {
          "home_temp": "[%key:common::state::home%]",
          "away_temp": "[%key:common::state::not_home%]",
          "comfort_temp": "[%key:component::climate::entity_component::_::state_attributes::preset_mode::state::comfort%]",
          "eco_temp": "[%key:component::climate::entity_component::_::state_attributes::preset_mode::state::eco%]",
          "sleep_temp": "[%key:component::climate::entity_component::_::state_attributes::preset_mode::state::sleep%]",
          "activity_temp": "[%key:component::climate::entity_component::_::state_attributes::preset_mode::state::activity%]"
        }
      }
    }
  },
  "config_subentries": {
    "room": {
      "entry_type": "Room",
      "initiate_flow": {
        "user": "Add room",
        "reconfigure": "Reconfigure room"
      },
      "step": {
        "user": {
          "title": "Add room",
          "data": {
            "name": "Room name",
            "sensor": "Temperature sensor",
            "cover": "Vent cover",
            "light": "Light",
            "door": "Door sensor",
            "mode": "Mode",
            "bedtime_mode": "Bedtime mode",
            "allows_override": "Allow override thermostat",
            "is_overflow": "Overflow room",
            "vents": "Vents"
          },
          "data_description": {
            "name": "A name for this room. Used to label the room's child thermostat and entities.",
            "sensor": "Temperature sensor that reflects this room's current temperature.",
            "cover": "Vent cover that opens and closes to control airflow into this room.",
            "light": "Optional light used to detect whether the room is occupied. Leave empty if the room has no light to track.",
            "door": "Optional door/contact sensor (where \"off\" means closed). When set and the door reads closed, this room is disabled while it would otherwise be secondary. Leave empty to never gate on a door.",
            "mode": "How this room participates: primary rooms drive the target temperature, secondary rooms follow along, and disabled rooms are excluded.",
            "bedtime_mode": "The mode this room uses while bedtime is active, overriding the standard mode.",
            "allows_override": "Create a dedicated child thermostat for this room so its target temperature can be overridden independently.",
            "is_overflow": "Treat this room as an overflow room that opens its vents to relieve excess airflow.",
            "vents": "Number of vents in this room. Used to weight how much airflow the room contributes."
          }
        },
        "reconfigure": {
          "title": "Reconfigure room",
          "data": {
            "name": "[%key:component::matt_thermostat::config_subentries::room::step::user::data::name%]",
            "sensor": "[%key:component::matt_thermostat::config_subentries::room::step::user::data::sensor%]",
            "cover": "[%key:component::matt_thermostat::config_subentries::room::step::user::data::cover%]",
            "light": "[%key:component::matt_thermostat::config_subentries::room::step::user::data::light%]",
            "door": "[%key:component::matt_thermostat::config_subentries::room::step::user::data::door%]",
            "mode": "[%key:component::matt_thermostat::config_subentries::room::step::user::data::mode%]",
            "bedtime_mode": "[%key:component::matt_thermostat::config_subentries::room::step::user::data::bedtime_mode%]",
            "allows_override": "[%key:component::matt_thermostat::config_subentries::room::step::user::data::allows_override%]",
            "is_overflow": "[%key:component::matt_thermostat::config_subentries::room::step::user::data::is_overflow%]",
            "vents": "[%key:component::matt_thermostat::config_subentries::room::step::user::data::vents%]"
          },
          "data_description": {
            "name": "[%key:component::matt_thermostat::config_subentries::room::step::user::data_description::name%]",
            "sensor": "[%key:component::matt_thermostat::config_subentries::room::step::user::data_description::sensor%]",
            "cover": "[%key:component::matt_thermostat::config_subentries::room::step::user::data_description::cover%]",
            "light": "[%key:component::matt_thermostat::config_subentries::room::step::user::data_description::light%]",
            "door": "[%key:component::matt_thermostat::config_subentries::room::step::user::data_description::door%]",
            "mode": "[%key:component::matt_thermostat::config_subentries::room::step::user::data_description::mode%]",
            "bedtime_mode": "[%key:component::matt_thermostat::config_subentries::room::step::user::data_description::bedtime_mode%]",
            "allows_override": "[%key:component::matt_thermostat::config_subentries::room::step::user::data_description::allows_override%]",
            "is_overflow": "[%key:component::matt_thermostat::config_subentries::room::step::user::data_description::is_overflow%]",
            "vents": "[%key:component::matt_thermostat::config_subentries::room::step::user::data_description::vents%]"
          }
        }
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "ac_mode": "[%key:component::matt_thermostat::config::step::user::data::ac_mode%]",
          "heater": "[%key:component::matt_thermostat::config::step::user::data::heater%]",
          "target_sensor": "[%key:component::matt_thermostat::config::step::user::data::target_sensor%]",
          "cold_tolerance": "[%key:component::matt_thermostat::config::step::user::data::cold_tolerance%]",
          "hot_tolerance": "[%key:component::matt_thermostat::config::step::user::data::hot_tolerance%]",
          "min_temp": "[%key:component::matt_thermostat::config::step::user::data::min_temp%]",
          "max_temp": "[%key:component::matt_thermostat::config::step::user::data::max_temp%]"
        },
        "data_description": {
          "heater": "[%key:component::matt_thermostat::config::step::user::data_description::heater%]",
          "target_sensor": "[%key:component::matt_thermostat::config::step::user::data_description::target_sensor%]",
          "ac_mode": "[%key:component::matt_thermostat::config::step::user::data_description::ac_mode%]",
          "cold_tolerance": "[%key:component::matt_thermostat::config::step::user::data_description::cold_tolerance%]",
          "hot_tolerance": "[%key:component::matt_thermostat::config::step::user::data_description::hot_tolerance%]"
        }
      },
      "presets": {
        "title": "[%key:component::matt_thermostat::config::step::presets::title%]",
        "data": {
          "home_temp": "[%key:common::state::home%]",
          "away_temp": "[%key:common::state::not_home%]",
          "comfort_temp": "[%key:component::climate::entity_component::_::state_attributes::preset_mode::state::comfort%]",
          "eco_temp": "[%key:component::climate::entity_component::_::state_attributes::preset_mode::state::eco%]",
          "sleep_temp": "[%key:component::climate::entity_component::_::state_attributes::preset_mode::state::sleep%]",
          "activity_temp": "[%key:component::climate::entity_component::_::state_attributes::preset_mode::state::activity%]"
        }
      }
    }
  },
  "services": {
    "reload": {
      "name": "[%key:common::action::reload%]",
      "description": "Reloads matt thermostats from the YAML-configuration."
    }
  }
}
